# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=troque_por_uma_string_longa_e_aleatoria
JWT_EXPIRES_IN=7d

# MySQL (Railway preenche automaticamente se usar o plugin deles)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bg_academy

# Google OAuth
# Obter em: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# URL do frontend (para redirect após OAuth)
FRONTEND_URL=http://localhost:5500
